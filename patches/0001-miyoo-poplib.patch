+SDL_Texture *SDLTextureData::GetMirroredTexture(MemoryImage *theImage)
+{
+	CheckCreateTextures(theImage);
+	if (mTextureMirrored != nullptr)
+		return mTextureMirrored;
+
+	int aWidth = theImage->GetWidth();
+	int aHeight = theImage->GetHeight();
+	ulong *bits = theImage->GetBits();
+	if (!bits || aWidth <= 0 || aHeight <= 0)
+		return mTexture;
+
+	ulong *mirroredBits = new ulong[aWidth * aHeight];
+	for (int y = 0; y < aHeight; ++y)
+	{
+		const ulong *srcRow = bits + y * aWidth;
+		ulong *dstRow = mirroredBits + y * aWidth;
+		for (int x = 0; x < aWidth; ++x)
+		{
+			dstRow[x] = srcRow[aWidth - 1 - x];
+		}
+	}
+
+	mTextureMirrored = SDL_CreateTexture(mRenderer, SDL_PIXELFORMAT_ARGB8888, SDL_TEXTUREACCESS_STATIC, aWidth, aHeight);
+	if (mTextureMirrored)
+	{
+		const char *rendererName = SDL_GetRendererName(mRenderer);
+		SDL_SetTextureScaleMode(mTextureMirrored, (rendererName && strcmp(rendererName, "software") == 0)
+													  ? SDL_SCALEMODE_NEAREST
+													  : SDL_SCALEMODE_LINEAR);
+		SDL_UpdateTexture(mTextureMirrored, nullptr, mirroredBits, aWidth * SDL_BYTESPERPIXEL(SDL_PIXELFORMAT_ARGB8888));
+	}
+	delete[] mirroredBits;
+	return mTextureMirrored ? mTextureMirrored : mTexture;
+}
